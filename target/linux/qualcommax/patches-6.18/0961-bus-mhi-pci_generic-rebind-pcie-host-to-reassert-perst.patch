From: Muhammad Huda Nugroho <mhudan21@gmail.com>
Subject: [PATCH] bus: mhi: pci_generic: re-bind the PCIe host to re-assert PERST#

On the IPQ5018 there is no reset left for a wedged modem once the MHI SoC
reset has failed. The endpoint (Quectel RG520N-EB, 17cb:0308) implements no
FLR, and the root port has no usable secondary bus reset, so the recovery
path's pci_try_reset_function() returns -ENOTTY and mhi_pci_recovery_work()
gives up with "Recovery failed". The board is then stuck until someone reboots
it: HW-tested on this port, neither unbinding mhi-pci-generic nor a PCI
remove+rescan clears a modem latched in MHI SYSERR, because neither touches
PERST#.

PERST# is the one line that does restart the modem firmware, and it belongs to
the host controller - pcie-qcom drives it in qcom_ep_reset_{assert,deassert}()
around its probe. Nothing in userspace can reach it: the GPIO is claimed by the
driver, qcom-pcie sets suppress_bind_attrs so the sysfs bind/unbind attributes
do not exist, and probe pins runtime PM active with a pm_runtime_get_sync() that
has no matching put. From kernel code it is reachable, because that flag only
gates the sysfs files and not the capability.

So as a last rung, re-bind the host controller in-kernel:
device_release_driver() tears the dead link down through the controller's
.remove, and device_attach() re-runs .probe, which re-asserts PERST#, retrains
and re-enumerates - the modem comes back with no board reboot.

The work has to be detached from the modem. Re-binding the host removes the
very pci_dev that scheduled it (freeing mhi_pdev), so it cannot live in
mhi_pdev->recovery_work, whose cancel_work_sync() in mhi_pci_remove() would
then deadlock on itself. It is its own allocation and holds a reference on the
host device for as long as it runs.

Signed-off-by: Muhammad Huda Nugroho <mhudan21@gmail.com>
---
--- a/drivers/bus/mhi/host/pci_generic.c
+++ b/drivers/bus/mhi/host/pci_generic.c
@@ -1190,6 +1190,59 @@
 	pm_runtime_put(mhi_cntrl->cntrl_dev);
 }
 
+/*
+ * Last-resort recovery for a modem whose PCIe link stays down after both the
+ * MHI SoC reset and pci_try_reset_function() failed: on the IPQ5018 the
+ * endpoint has no FLR and the root port has no usable bus reset, so
+ * pci_try_reset_function() returns -ENOTTY. The only reset that restarts the
+ * modem firmware is PERST#, owned by the host controller (pcie-qcom asserts it
+ * in qcom_ep_reset_{assert,deassert}() during its probe). Re-bind the host
+ * controller in-kernel: its .remove tears the dead link down and .probe re-runs
+ * the PERST sequence + retrains + re-enumerates, bringing the modem back with
+ * no board reboot. device_release_driver()/device_attach() work regardless of
+ * the controller's suppress_bind_attrs (that flag only gates the sysfs files).
+ *
+ * This MUST run detached from the modem: re-binding the host removes this very
+ * pci_dev (freeing mhi_pdev), so the work is its own allocation, holds a
+ * reference on the host device, and is NOT mhi_pdev->recovery_work (whose
+ * mhi_pci_remove -> cancel_work_sync would deadlock on itself).
+ */
+struct mhi_pci_host_rebind {
+	struct work_struct work;
+	struct device *host;
+};
+
+static void mhi_pci_host_rebind_work(struct work_struct *work)
+{
+	struct mhi_pci_host_rebind *rb =
+		container_of(work, struct mhi_pci_host_rebind, work);
+
+	device_release_driver(rb->host);
+	device_attach(rb->host);
+	put_device(rb->host);
+	kfree(rb);
+}
+
+static void mhi_pci_schedule_host_rebind(struct pci_dev *pdev)
+{
+	struct pci_host_bridge *hb = pci_find_host_bridge(pdev->bus);
+	struct mhi_pci_host_rebind *rb;
+
+	if (!hb || !hb->dev.parent)
+		return;
+
+	rb = kzalloc(sizeof(*rb), GFP_KERNEL);
+	if (!rb)
+		return;
+
+	INIT_WORK(&rb->work, mhi_pci_host_rebind_work);
+	rb->host = get_device(hb->dev.parent);
+	dev_warn(&pdev->dev,
+		 "recovery: re-binding PCIe host %s to re-assert PERST# (no reboot)\n",
+		 dev_name(hb->dev.parent));
+	schedule_work(&rb->work);
+}
+
 static void mhi_pci_recovery_work(struct work_struct *work)
 {
 	struct mhi_pci_device *mhi_pdev = container_of(work, struct mhi_pci_device,
@@ -1239,8 +1292,11 @@
 	mhi_unprepare_after_power_down(mhi_cntrl);
 err_try_reset:
 	err = pci_try_reset_function(pdev);
-	if (err)
+	if (err) {
 		dev_err(&pdev->dev, "Recovery failed: %d\n", err);
+		/* no FLR/SBR here: re-bind the host controller to re-assert PERST# */
+		mhi_pci_schedule_host_rebind(pdev);
+	}
 }
 
 static void health_check(struct timer_list *t)
