#!/bin/sh
# QDM530: pin the 5 GHz radio (QCN9074 on PCIe) to channel 36 / HE160 and bring the
# wireless stack up cleanly once that radio appears.
#
# The QCN9074 enumerates ~20 s into boot over PCIe - after the uci-defaults run - so
# its channel cannot be fixed there (it is not in /etc/config/wireless yet). Its
# board.bin carries no real per-board caldata (board_id reads 0xff), so ath11k's
# self-managed regulatory domain is driven entirely by the country code: with
# country=CN (set here and in 25_set-wireless-country) it exposes the full 5 GHz band
# at up to 160 MHz (HW-verified); ID / the "00" world default would collapse it to
# 20 MHz. ch36 / HE160 (5250 center, 23 dBm) matches the vendor firmware; it spans the
# DFS sub-band (5250-5330), so bring-up runs a one-time ~60 s CAC before the AP beacons
# (CAC-COMPLETED success, radar_detected=0, HW-verified). An alternative that avoids DFS
# is ch149 / HE80 (UNII-3, 5775 center, 33 dBm, non-DFS) - also CN, no CAC wait.
#
# Both self-managed radios also -95 their FIRST setup attempt, before the country
# code settles, and the boot-time bring-up can lose that race and leave a radio
# stuck down (so Wi-Fi is not reliably up every boot). So when the (late) 5 GHz
# radio appears, after setting its channel, do a full `wifi` reload: that re-applies
# the country code and brings BOTH radios up cleanly, which is what reliably clears
# the -95. `wifi` reloads only the wireless stack, so the cellular WAN (wwand on
# PCIe/MHI) is NOT touched - unlike `ubus call network reload`, which would bounce
# the WAN too.
[ "${ACTION}" = "add" ] || exit 0

. /lib/functions.sh

[ "$(board_name)" = "unbranded,qdm530" ] || exit 0

have_5g=0
changed=0

fixup_5g() {
	local radio="$1" band
	config_get band "$radio" band
	[ "$band" = "5g" ] || return 0
	have_5g=1
	[ "$(uci -q get "wireless.$radio.channel")" = "36" ] &&
	[ "$(uci -q get "wireless.$radio.htmode")" = "HE160" ] &&
	[ "$(uci -q get "wireless.$radio.country")" = "CN" ] && return 0
	uci -q set "wireless.$radio.channel=36"
	uci -q set "wireless.$radio.htmode=HE160"
	uci -q set "wireless.$radio.country=CN"
	changed=1
}

config_load wireless
config_foreach fixup_5g wifi-device

[ "$changed" = 1 ] && uci -q commit wireless

# Only when the 5 GHz radio is actually present (this is its hotplug, not the 2.4
# GHz one): reload the wireless stack to bring both radios up cleanly. wifi touches
# only wireless, so the WAN is left alone.
[ "$have_5g" = 1 ] && /sbin/wifi

exit 0
