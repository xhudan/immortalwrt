#!/bin/sh
# QDM530: pin the 5 GHz radio (QCN9074 on PCIe) to channel 36 / HE160 and bring the
# wireless stack up cleanly once that radio appears.
#
# The QCN9074 enumerates ~20 s into boot over PCIe - after the uci-defaults run - so
# its channel cannot be fixed there (it is not in /etc/config/wireless yet). Its
# board.bin carries no real per-board caldata (board_id reads 0xff), so ath11k's
# self-managed regulatory domain is driven entirely by the country code: with
# country=CN (set here and in 25_set-wireless-country) it exposes the full 5 GHz band
# at up to 160 MHz (HW-verified); ID / the "00" world default would collapse it to
# 20 MHz. ch36 / HE160 (5250 center, 23 dBm) matches the vendor firmware; it spans the
# DFS sub-band (5250-5330), so bring-up runs a one-time ~60 s CAC before the AP beacons
# (CAC-COMPLETED success, radar_detected=0, HW-verified). An alternative that avoids DFS
# is ch149 / HE80 (UNII-3, 5775 center, 33 dBm, non-DFS) - also CN, no CAC wait.
#
# Both self-managed radios also -95 their FIRST setup attempt, before the country
# code settles, and the boot-time bring-up can lose that race and leave a radio
# stuck down (so Wi-Fi is not reliably up every boot). So when the (late) 5 GHz
# radio appears, after setting its channel, do a full `wifi` reload: that re-applies
# the country code and brings BOTH radios up cleanly, which is what reliably clears
# the -95. `wifi` reloads only the wireless stack, so the cellular WAN (wwand on
# PCIe/MHI) is NOT touched - unlike `ubus call network reload`, which would bounce
# the WAN too.
[ "${ACTION}" = "add" ] || exit 0

. /lib/functions.sh
. /lib/functions/system.sh

[ "$(board_name)" = "unbranded,qdm530" ] || exit 0

have_5g=0
changed=0

# Apply the board defaults ONCE, on the radio's first appearance, recorded by a marker.
#
# Two earlier versions of this were both wrong. The first re-asserted channel, htmode and
# country on every event, which silently reverted anything the operator had changed. The
# second only filled in values that were absent - which sounds safer and is useless here,
# because `wifi detect` has already written its own htmode (HE80) by the time this runs, so
# the board's HE160 default never got applied at all. Verified on hardware: a fresh
# `sysupgrade -n` came up at 80 MHz.
#
# "Absent" was the wrong test. What distinguishes the operator's choice from a generated
# default is not emptiness, it is whether we have ever seeded this board before.
SEEDED=/etc/qdm530-5ghz-seeded

seed_5g() {
	local radio="$1" band
	config_get band "$radio" band
	[ "$band" = "5g" ] || return 0
	have_5g=1
	[ -e "$SEEDED" ] && return 0          # operator territory from here on

	# MIGRATION: a config-preserving upgrade from a build older than the marker
	# arrives with no marker and a radio that IS already configured, and writing
	# our defaults over it would replace a deliberate choice. `country` tells the
	# two apart. On a fresh flash this radio has none when the event fires:
	# 25_set-wireless-country runs as a uci-default, before the QCN9074
	# enumerates (~20 s in), so it never sees this section, and `wifi detect`
	# does not write country either. A 5 GHz radio that already has one was
	# therefore configured by an earlier seeding or by hand - adopt it, record
	# the marker so this never runs again, and change nothing.
	if [ -n "$(uci -q get "wireless.$radio.country")" ]; then
		seeded_5g=1
		changed=1
		return 0
	fi
	# `seeded_5g` is deliberately NOT the shared `changed`: the marker must mean
	# "the 5 GHz defaults were written", and nothing else. Sharing one flag let a
	# 2.4 GHz-only event (which seeds a MAC and sets `changed`) create the marker,
	# after which the 5 GHz radio appearing seconds later was skipped at the test
	# above - reinstating the very HE80 failure described at the top of this file.
	uci -q set "wireless.$radio.channel=36" || return 0
	uci -q set "wireless.$radio.htmode=HE160" || return 0
	uci -q set "wireless.$radio.country=CN" || return 0
	seeded_5g=1
	changed=1
}

# A stable BSSID per radio, derived from the board's base address (24_generate-macaddr).
# Set on the wifi-iface, which is the section mac80211 actually applies - not on the
# wifi-device, where `macaddr` is a phy selector. Without this the phy address is random
# per boot: this board read 00:03:7f:12:1d:1d then 00:03:7f:12:2a:2a across two boots.
# Find the bridge by NAME, the same rule 24_generate-macaddr uses. @device[0] is
# not reliably br-lan, and the two must agree or the offsets below are measured
# from a different base than the generator used.
lan_base() {
	local i=0 n
	while uci -q get "network.@device[$i]" >/dev/null 2>&1; do
		n=$(uci -q get "network.@device[$i].name")
		if [ "$n" = "br-lan" ]; then
			uci -q get "network.@device[$i].macaddr"
			return 0
		fi
		i=$((i + 1))
	done
	cat /sys/class/net/br-lan/address 2>/dev/null
}

# ONE address per band, and only for that band's FIRST wifi-iface. An earlier
# version keyed the offset on the band alone, so every 2.4 GHz interface got
# base+1 and every 5 GHz one base+2 - a guest SSID beside the primary on the
# same radio was handed an IDENTICAL MAC. Seeding only the default interface
# keeps the addresses deterministic without inventing an allocation scheme whose
# numbering would shift whenever an SSID is added or removed; extra interfaces
# are left to mac80211, which derives their BSS addresses itself.
seed_iface_mac() {
	local ifsec="$1" dev band base off mac
	config_get dev "$ifsec" device
	[ -n "$dev" ] || return 0
	band=$(uci -q get "wireless.$dev.band")
	# CLAIM THE BAND FIRST, before asking whether this interface already has an
	# address. Testing that first let a primary AP seeded on an EARLIER event
	# fall straight through without marking its band, so the next interface on
	# the same radio - a guest SSID - was handed the very same address. Only the
	# first interface of a band may hold that band's derived address, whether or
	# not it is already holding it.
	#
	# Two plain flags rather than one built with eval: this runs under busybox
	# ash on the board, and an indirect-expansion trick would need verifying
	# there instead of simply being unambiguous everywhere.
	case "$band" in
		2g) [ -n "$did_2g" ] && return 0; did_2g=1; off=1 ;;
		5g) [ -n "$did_5g" ] && return 0; did_5g=1; off=2 ;;
		*)  return 0 ;;
	esac
	[ -n "$(uci -q get "wireless.$ifsec.macaddr")" ] && return 0
	base=$(lan_base)
	[ -n "$base" ] || return 0
	mac=$(macaddr_add "$base" "$off") || return 0
	case "$mac" in
		??:??:??:??:??:??) ;;
		*) return 0 ;;
	esac
	uci -q set "wireless.$ifsec.macaddr=$mac" || return 0
	changed=1
}

config_load wireless
config_foreach seed_5g wifi-device

# NOT gated on the marker, unlike seed_5g. Nothing else ever writes macaddr on a
# wifi-iface, so its own "already set?" test is meaningful on its own - and gating it
# here would mean a config-preserving upgrade never gets stable BSSIDs, which is exactly
# the upgrade someone does when they do not want to lose their settings.
config_foreach seed_iface_mac wifi-iface

if [ "$changed" = 1 ]; then
	# The marker is written ONLY when the 5 GHz defaults were among what was
	# committed. A MAC-only commit must not claim the 5 GHz seeding happened.
	if uci -q commit wireless; then
		[ "$seeded_5g" = 1 ] && : > "$SEEDED"
	fi
fi

# Only when a 5 GHz wifi-device exists in the config: reload the wireless stack to
# bring both radios up cleanly. wifi touches only wireless, so the WAN is left
# alone. Note what this does NOT check - the identity of the phy that fired this
# event. have_5g comes from scanning the config, so a 2.4 GHz event that happens
# after the 5 GHz radio is already in the config will also reload. That is
# harmless here (the reload is idempotent) but it is not the "this is its hotplug"
# test an earlier comment claimed it was.
[ "$have_5g" = 1 ] && /sbin/wifi

exit 0
