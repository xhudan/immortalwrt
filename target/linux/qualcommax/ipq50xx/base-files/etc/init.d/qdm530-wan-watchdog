#!/bin/sh /etc/rc.common
# Cellular WAN connection monitor: active L3 probe -> wwand recovery ladder.
# See /usr/sbin/qdm530-wan-watchdog.

START=97
USE_PROCD=1

start_service() {
	[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "unbranded,qdm530" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/qdm530-wan-watchdog
	procd_set_param respawn
	procd_close_instance
}
