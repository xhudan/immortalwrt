#!/bin/sh
#
# QDM530: seed the cellular WAN. The WAN is the Quectel RG520N-EB 5G modem on
# PCIe/MHI, driven by wwand. The modem exposes no cdc-wdm control node - its QMI
# runs on the QRTR bus (mhi0_IPCR via qcom_mhi_qrtr) - so wwand's QMI-over-QRTR
# transport is selected with the sentinel `option device 'qrtr'`. The data path
# is rmnet/QMAP on the MHI net device mhi_hwip0 (mux child wwand0, mux_id 1).
#
# wwand is configured network-native (everything in /etc/config/network): a
# wwand_modem section for the hardware and a proto-wwand interface for the
# connection. ucidef in board.d cannot express a proto-wwand interface, so it is
# seeded here instead.
#
# The WDA data-format endpoint (ep_type PCIE / ep_id 4) and the QMAP version are
# auto-derived by wwand (>= 1.7.0_pre7): the PCIe/MHI endpoint comes from the data
# netdev's resolved sysfs path and the QMAP ladder negotiates the version itself
# (lands on v5 here), so no overrides are seeded - HW-verified on this board. If you
# run an older wwand that needs them, add network.wwmodem.ep_type='3', ep_id='4',
# qmap_version='1' back. pdp_type is ipv4v6 (dual-stack works); the modem continues
# IPv4-only if the carrier rejects the IPv6 PDP. APN is left to the SIM/network
# default - set network.wwmodem.apn (or network.wan.apn) if the carrier needs one.
#
# Recovery ladder: wwand climbs it on repeated activation failures, firing a
# hardware rung at the attempt counts in `recovery_steps` and finally a board
# reboot at `failreboot` + 1. The defaults (8/16/24, failreboot 100) are tuned
# for boards where the rungs can actually do something; two of them cannot here:
#   - `usb_repower`, the third rung, is a GUARANTEED no-op on this board. It
#     pulses a modem power or reset line of the kind wwand can drive, and there
#     is none: the vendor DTB gives the modem's PCIe node only `perst-gpio`
#     (GPIO 18) - which the PCIe host driver owns, not wwand - no power GPIO, no
#     supply, no GPIO regulator (see docs/qdm530/aer-hang.md).
#   - `opmode_cycle` and `modem_reset` are QMI commands, so they need a modem
#     that still answers. A modem latched in MHI SYSERR does not, and nothing
#     short of a board reboot clears that - HW-tested: neither a host re-bind
#     nor a PCI remove+rescan does.
# So for the failure that actually hurts, the reboot is the only rung that
# works, and the default put it at attempt 101 ~= 47 min of backoff (the retry
# backoff is min(n*2s, 30s), so attempt N costs N*(N-1) s up to N=16, then 30 s
# each). Compress the ladder: both useful QMI rungs early and cheap, reboot at
# attempt 16 ~= 4 min of backoff (~6-8 min with the time each attempt takes).
# Not faster than that on purpose - a reboot costs ~2-3 min of its own here
# (boot, clients reassociating, ~60 s DFS CAC on ch36/HE160), so rebooting
# sooner would trade a possible self-recovery for certain downtime.
#
# zero_rx_timeout 120 (upstream default 21600 = 6 h) is the DETECTION latency in
# front of that ladder: wwand's rx_stall_watch trips when the cumulative rx
# counter has stood still this long. It reads only rx -- TX is never consulted --
# so on a CGNAT'd cellular link with an idle LAN it cannot tell a dead bearer
# from a quiet one, and 6 h is upstream being honest about that. 120 s is safe
# here ONLY because /usr/sbin/qdm530-wan-keepalive keeps one echo per 30 s
# flowing on the WAN, which makes "no rx" mean dead rather than idle.
# THE ORDER MATTERS: never shorten this without that probe running, or a quiet
# night trips the watchdog on a healthy link and climbs the ladder to a reboot.
#
# KNOWN WEAKNESS of this pairing, and the native alternative. The probe makes
# "no rx" mean "dead" only when the probe itself is answered. If it goes
# unanswered for reasons upstream of the modem -- ICMP filtered, a carrier
# outage, a routing problem -- then rx stands still on a link whose bearer is
# fine, and 120 s later the daemon starts climbing the ladder. The probe reduces
# the idle/dead ambiguity; it does not remove the false positive.
#
# wwand's own answer to this is NOT an in-daemon probe: ddimension/wwand#13 was
# closed having rejected one ("An ICMP probe is squarely L3: it needs a source
# address, a route, a firewall zone, and DNS if the target is a name"), and the
# maintainer implemented `context_failed` on the ubus interface instead
# (src-ucode/ubus.uc, daemon.uc, with a rate limit and a unit test). The
# intended arrangement is that something which actually understands routes and
# reachability decides, calls context_failed, and lets the daemon run the rungs
# it cannot reach itself -- while zero_rx_timeout stays at its conservative
# default as a backstop rather than as the detector.
#
# Moving to that is a policy change for this board, not a bug fix: it trades a
# detector that can false-positive into a reboot for one that depends on an
# external monitor being correct and running. Left as it is deliberately, with
# the trade-off written down.
. /lib/functions.sh

[ "$(board_name)" = "unbranded,qdm530" ] || exit 0

# idempotent: only seed when the modem section is absent, so a config-preserving
# sysupgrade (or a user who edited the WAN) is never overwritten.
if ! uci -q get network.wwmodem >/dev/null; then
	uci -q batch <<-EOF
		set network.wwmodem='wwand_modem'
		set network.wwmodem.device='qrtr'
		set network.wwmodem.protocol='qmi'
		set network.wwmodem.netdev='mhi_hwip0'
		set network.wwmodem.recovery_steps='4 10 14'
		set network.wwmodem.failreboot='15'
		set network.wwmodem.zero_rx_timeout='120'
	EOF
fi

if ! uci -q get network.wan >/dev/null; then
	uci -q batch <<-EOF
		set network.wan='interface'
		set network.wan.proto='wwand'
		set network.wan.device='wwand0'
		set network.wan.modem='wwmodem'
		set network.wan.autosetup='1'
		set network.wan.mux_id='1'
		set network.wan.pdp_type='ipv4v6'
	EOF
fi

uci -q commit network

exit 0
