#!/bin/sh

. /lib/functions.sh

case "$(board_name)" in
unbranded,qdm530)
	;;
*)
	exit 0
	;;
esac

# Use country=CN - the same domain the vendor firmware ships. The QCN9074 has a
# blank OTP (board_id reads 0xff), so ath11k's self-managed regulatory domain is
# driven entirely by the country code, not by any caldata/board.bin: CN maps to a
# DFS-FCC domain that exposes the full 5 GHz band, whereas ID (and the "00" world
# default) collapse to "FW Regdomain 0" and clamp the 5GHz radio to 20 MHz / 20 dBm.
# HW-verified: CN unlocks ch36 HE160 (23 dBm, the default) and ch149 HE80 (33 dBm).
[ -e /etc/config/wireless ] || /sbin/wifi config

radios="$(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-device$/\1/p')"

# Retry on the next boot if the radios have not been detected yet: uci-defaults
# scripts are only removed once they exit successfully.
[ -n "$radios" ] || exit 1

for radio in $radios; do
	uci -q set "wireless.$radio.country=CN"
done

uci -q commit wireless

# The 5GHz radio's channel/width is NOT fixed here. The QCN9074 sits on PCIe and
# enumerates ~20s into boot, after this script runs, so it is usually not in the
# config yet. Its channel/width (36 / HE160, matching the vendor now that CN unlocks
# the full 5 GHz band) is pinned from the ieee80211 hotplug instead, which fires when
# the radio's phy appears: see base-files/etc/hotplug.d/ieee80211/13-qdm530-5ghz-channel.

exit 0
