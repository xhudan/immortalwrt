#!/bin/sh
#
# QDM530: enable the cellular WAN connection monitor (active L3 probe ->
# wwand context_failed/modem_reset recovery). (The ipq50xx base-files are shared
# across devices, so guard by board; the service also self-guards on start.)
#
. /lib/functions.sh

[ "$(board_name)" = "unbranded,qdm530" ] || exit 0

/etc/init.d/qdm530-wan-watchdog enable

exit 0
