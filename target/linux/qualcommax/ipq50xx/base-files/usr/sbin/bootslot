#!/bin/sh
# bootslot — show or switch the A/B boot slot from a running ImmortalWrt.
#
# The QSDK bootloader picks the rootfs slot from a BOOTCONFIG struct in the
# "0:BOOTCONFIG"/"0:BOOTCONFIG1" mtd partitions. ImmortalWrt has no /proc/boot_info driver,
# so this edits that struct directly: it flips the rootfs "primaryboot" flag (byte 128) in
# BOTH copies, written identically from one read of the active copy. Writing both copies
# identical means the bootloader always sees one consistent flag, so the redundancy/age
# counter does not need to change (and is left untouched). Verified against the vendor
# getbinary output: a slot switch changes only the flag byte; there is no content checksum.
#
# The 4-byte magic and the flag byte are matched by their md5/sha256 (whichever hash tool is
# present) rather than parsed as numbers, so this works on images whose busybox lacks od and
# hexdump.
#
# Writing two partitions cannot be made atomic from here, and nothing below changes that.
# What it does do: read and byte-compare BOTH copies first and refuse if they differ, verify
# each write over the whole record before moving on, and if the SECOND write returns an error
# try to restore the first from the original bytes. That covers a failed write, NOT a power
# loss or a kill: neither can run the restore, and a write that failed part-way may have left
# copy 1 erased or partly written, so a successful restore of copy 0 means "one known-good old
# copy", not "the two copies agree". After any failure here, re-run `bootslot status` and do
# not reboot until it reports both copies agreeing.
#
# Usage:
#   bootslot [status]    show the current flag and which mtd the other slot is (read-only)
#   bootslot inspect     additionally attach the other slot's UBI to see what it holds
#   bootslot switch      flip to the other slot (refuses if it holds no valid UBI image)
#
# !!! There is NO recovery without UART if you switch to a slot that cannot boot. !!!

FLAG_OFF=128    # byte offset of the rootfs primaryboot flag (this board's BOOTCONFIG layout)
REC_LEN=336     # bytes of the BOOTCONFIG record this script reads and rewrites
UBI_DEV=9       # scratch ubi device number used only for inspection

# pick a hash tool that exists here, with the matching precomputed digests of the 4-byte
# magics and the single flag bytes 0x00 / 0x01.
if command -v md5sum >/dev/null 2>&1; then
	HASH=md5sum
	MAGIC_H=e8370991fc78834b93667db716d19df7   # a0 a1 a2 a3
	F0_H=93b885adfe0da089cdf634904fd59f71       # 0x00
	F1_H=55a54008ad1ba589aa210d2629c1df41       # 0x01
elif command -v sha256sum >/dev/null 2>&1; then
	HASH=sha256sum
	MAGIC_H=73b92b68882b199971462a2614c6691cba581da958740466030a64ce7de66ed3
	F0_H=6e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d
	F1_H=4bf5122f344554c53bde2ebb8cd2b7e3d1600ad631c385a5d7cce23c7785459a
else
	echo "bootslot: need md5sum or sha256sum" >&2; exit 1
fi

LOCKDIR=/tmp/bootslot.lock
TMPDIR_=""
cleanup(){ [ -n "$TMPDIR_" ] && rm -rf "$TMPDIR_"; rmdir "$LOCKDIR" 2>/dev/null; }
# A signal handler that only cleans up would release the lock and delete the staging file
# while the script carried on running, so handle signals by exiting.
on_signal(){ echo "bootslot: interrupted" >&2; exit 130; }
die(){ echo "bootslot: $*" >&2; exit 1; }

# One instance only: two concurrent switches could interleave their writes to the two copies.
mkdir "$LOCKDIR" 2>/dev/null || { echo "bootslot: another instance is running ($LOCKDIR)" >&2; exit 1; }
trap cleanup EXIT
trap on_signal INT TERM HUP
TMPDIR_=$(mktemp -d /tmp/bootslot.XXXXXX) || die "cannot create a temporary directory"

# match the partition label case-insensitively: the QSDK SMEM table is rendered UPPERCASE on
# the vendor firmware ("0:BOOTCONFIG") but lowercase on ImmortalWrt ("0:bootconfig").
mtdof(){ grep -i "\"$1\"" /proc/mtd | sed -n 's/^mtd\([0-9][0-9]*\):.*/\1/p' | head -1; }
hb(){ dd if="$1" bs=1 skip="$2" count="$3" 2>/dev/null | $HASH | cut -d' ' -f1; }  # hash of $3 bytes at offset $2
flagof(){ # -> 0 | 1 | "" for anything else
	case "$(hb "$1" "$FLAG_OFF" 1)" in
		"$F0_H") echo 0 ;;
		"$F1_H") echo 1 ;;
	esac
}

bc0=$(mtdof "0:BOOTCONFIG"); bc1=$(mtdof "0:BOOTCONFIG1")
[ -n "$bc0" ] && [ -n "$bc1" ] || die "no 0:BOOTCONFIG partitions in /proc/mtd — not a QSDK A/B board, nothing to do."

# Validate BOTH copies before trusting either: copy 0 is not authoritative just because it
# is first, and a disagreement means something else has been writing these. Compare the whole
# record, not just the magic and the flag — other fields differing would otherwise be silently
# overwritten from copy 0 when the switch rewrites both from one read.
[ "$(hb "/dev/mtd$bc0" 0 4)" = "$MAGIC_H" ] || die "BOOTCONFIG magic mismatch — refusing to touch it."
[ "$(hb "/dev/mtd$bc1" 0 4)" = "$MAGIC_H" ] || die "BOOTCONFIG1 magic mismatch — refusing to touch it."
[ "$(hb "/dev/mtd$bc0" 0 "$REC_LEN")" = "$(hb "/dev/mtd$bc1" 0 "$REC_LEN")" ] \
	|| die "the two BOOTCONFIG copies differ over the first $REC_LEN bytes — refusing to rewrite both from one of them."

cur=$(flagof "/dev/mtd$bc0")
cur1=$(flagof "/dev/mtd$bc1")
[ -n "$cur" ] || die "rootfs flag byte in BOOTCONFIG is not 0/1 — layout mismatch, refusing."
[ -n "$cur1" ] || die "rootfs flag byte in BOOTCONFIG1 is not 0/1 — layout mismatch, refusing."
[ "$cur" = "$cur1" ] || die "BOOTCONFIG says $cur but BOOTCONFIG1 says $cur1 — the copies disagree, refusing to guess which the bootloader will read."
new=$(( 1 - cur ))

# inactive slot (the one that would boot after a switch) = the rootfs-pair mtd ubi0 is NOT on.
act=$(cat /sys/class/ubi/ubi0/mtd_num 2>/dev/null)
[ -n "$act" ] || act=$(dmesg 2>/dev/null | sed -n 's/.*ubi0: attached mtd\([0-9][0-9]*\).*/\1/p' | tail -1)
[ -n "$act" ] || die "cannot determine the running rootfs mtd (ubi0) — refusing to guess the other slot."
ra=$(mtdof "rootfs"); rb=$(mtdof "rootfs_1")
[ -n "$ra" ] && [ -n "$rb" ] || die "cannot find both rootfs partitions — refusing."
# Do not fall back to "the other one" for an active mtd that is neither of the pair: that
# would nominate a slot with no relation to what is actually running.
case "$act" in
	"$ra") other=$rb ;;
	"$rb") other=$ra ;;
	*) die "the running rootfs is mtd$act, which is neither rootfs (mtd$ra) nor rootfs_1 (mtd$rb) — refusing to guess the other slot." ;;
esac

# inspect a slot's UBI: prints IMMORTALWRT | OTHER-OS | EMPTY | ERROR  ($1 = mtd num).
# Identify by VOLUME NAMES, not by magic: the vendor firmware also has a FIT kernel, so a
# magic check cannot tell it apart. ImmortalWrt has volumes "kernel" + "rootfs" (+rootfs_data);
# the vendor has "ubi_rootfs"/"wifi_fw"/"bt_fw" instead. Any slot with >=2 volumes is treated
# as a valid switch target (IMMORTALWRT or OTHER-OS); EMPTY (<2 volumes) or ERROR (won't
# attach) is refused. That is a heuristic, not a boot test: ">=2 UBI volumes" is not proof
# that the slot can boot, and this cannot be proved from a running system.
# NOT used by `status`, which stays read-only — attaching UBI is a side effect.
# Only ever detach an attachment this script created: an existing ubi$UBI_DEV belongs to
# someone else, and detaching it because it merely exists would pull the rug out from under
# them. If it is occupied, refuse rather than guess.
inspect_slot(){
	if [ -d "/sys/class/ubi/ubi$UBI_DEV" ]; then
		echo "bootslot: ubi$UBI_DEV is already attached — refusing to use it as scratch" >&2
		echo ERROR
		return
	fi
	ubiattach -m "$1" -d "$UBI_DEV" >/dev/null 2>&1 || { echo ERROR; return; }
	vols=$(ubinfo -a -d "$UBI_DEV" 2>/dev/null | sed -n 's/^Name:[[:space:]]*//p')
	ubidetach -d "$UBI_DEV" 2>/dev/null
	n=$(printf '%s\n' "$vols" | grep -c .); n=${n:-0}
	if [ "$n" -lt 2 ] 2>/dev/null; then echo EMPTY
	elif printf '%s\n' "$vols" | grep -qx 'kernel' && printf '%s\n' "$vols" | grep -qx 'rootfs'; then echo IMMORTALWRT
	else echo OTHER-OS; fi
}

case "${1:-status}" in
status)
	echo "BOOTCONFIG rootfs flag = $cur   (switch would set it to $new)"
	echo "both copies agree (mtd$bc0, mtd$bc1)"
	echo "running rootfs = mtd$act ; the other slot = mtd$other"
	echo "(run 'bootslot inspect' to attach mtd$other and see what it holds)"
	;;
inspect)
	echo "other slot (mtd$other) contents: $(inspect_slot "$other")"
	;;
switch)
	kind=$(inspect_slot "$other")
	case "$kind" in
		IMMORTALWRT|OTHER-OS) ;;
		*) die "the other slot (mtd$other) looks '$kind' — no valid UBI image there. NOT switching (you would brick with no UART)." ;;
	esac
	echo "other slot (mtd$other) holds: $kind"
	echo "switching rootfs flag $cur -> $new (writing both BOOTCONFIG copies identically)"

	orig="$TMPDIR_/orig.bin"; want="$TMPDIR_/want.bin"
	dd if="/dev/mtd$bc0" of="$orig" bs=1 count="$REC_LEN" 2>/dev/null || die "reading BOOTCONFIG failed"
	[ "$(wc -c < "$orig")" = "$REC_LEN" ] || die "short read from BOOTCONFIG ($(wc -c < "$orig") of $REC_LEN bytes) — refusing to write."

	cp "$orig" "$want" || die "cannot stage the new record"
	printf "$(printf '\\%03o' "$new")" | dd of="$want" bs=1 seek="$FLAG_OFF" count=1 conv=notrunc 2>/dev/null \
		|| die "patching the flag byte failed"
	[ "$(flagof "$want")" = "$new" ] || die "staged record does not carry flag $new — refusing to write."

	# Verify each write in full (all $REC_LEN bytes), not just the flag byte.
	verify(){ [ "$(hb "$1" 0 "$REC_LEN")" = "$(hb "$2" 0 "$REC_LEN")" ]; }

	mtd write "$want" "/dev/mtd$bc0" || die "mtd write BOOTCONFIG failed"
	verify "/dev/mtd$bc0" "$want" || die "BOOTCONFIG readback differs from what was written — do NOT reboot, investigate."

	if ! mtd write "$want" "/dev/mtd$bc1"; then
		echo "bootslot: writing BOOTCONFIG1 failed — restoring BOOTCONFIG to slot $cur" >&2
		if mtd write "$orig" "/dev/mtd$bc0" && verify "/dev/mtd$bc0" "$orig"; then
			die "BOOTCONFIG restored to slot $cur, but BOOTCONFIG1 may be erased or partly written — run 'bootslot status' and do NOT reboot until it reports both copies agreeing."
		fi
		die "ROLLBACK FAILED: BOOTCONFIG may be on $new and BOOTCONFIG1 is in an unknown state. Do NOT reboot before fixing this."
	fi
	verify "/dev/mtd$bc1" "$want" || die "BOOTCONFIG1 readback differs from what was written — do NOT reboot, investigate."

	echo "done — rootfs flag is now $new in both copies. Reboot to boot the other slot."
	echo "(if the other slot does not come up, UART/TFTP is the only recovery.)"
	;;
*) echo "usage: bootslot [status|inspect|switch]"; exit 1 ;;
esac
